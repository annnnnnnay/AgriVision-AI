# AgriVision AI — Frontend Environment Configuration
# ====================================================

# Backend API URL (leave empty to use Vite proxy in development)
VITE_API_URL=

# Supabase Auth (use the public anon/publishable key; never use service_role here)
# Get these from Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set true to allow limited guest analysis in production.
VITE_ENABLE_GUEST_DEMO=false
