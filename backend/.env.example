# AgriVision AI — Environment Configuration
# ===========================================

# Application
APP_NAME="AgriVision AI"
DEBUG=false
ENVIRONMENT=development
LOCAL_DEMO_MODE=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (JSON array of origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5176","http://127.0.0.1:5176","http://localhost:3000"]

# ML Model
MODEL_DIR=ml/models
MODEL_NAME=best_model.keras
MODEL_VERSION=1.0.0
IMAGE_SIZE=160
CONFIDENCE_THRESHOLD=0.40
MAX_FILE_SIZE_MB=10

# Firebase (optional — leave empty for dev mode without Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Optional cloud services
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
PREDICTION_PROVIDER_TIMEOUT_SECONDS=25

# Security
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
